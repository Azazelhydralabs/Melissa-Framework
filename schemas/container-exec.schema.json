{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "melissa.container-exec/v1",
  "title": "Explicit offline Linux container request; schema grants no authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "image_id",
    "executable",
    "argv",
    "cwd",
    "env",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "melissa.container-exec/v1"
    },
    "image_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "executable": {
      "type": "string",
      "minLength": 2,
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))/[^\\\\\\u0000]+$"
    },
    "argv": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "string",
        "pattern": "^[^\u0000]*$"
      }
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/|.*(?:^|/)\\.\\.(?:/|$))[^\\\\\u0000]+$"
    },
    "env": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[^\u0000]*$"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_ms",
        "cpu_time_ms",
        "cpu_rate_basis_points",
        "memory_bytes",
        "disk_bytes",
        "output_bytes",
        "max_processes",
        "export_bytes"
      ],
      "properties": {
        "wall_time_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800000
        },
        "cpu_time_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800000
        },
        "cpu_rate_basis_points": {
          "type": "integer",
          "minimum": 10,
          "maximum": 10000
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 33554432,
          "maximum": 8589934592
        },
        "disk_bytes": {
          "type": "integer",
          "minimum": 4096,
          "multipleOf": 4096
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "max_processes": {
          "type": "integer",
          "minimum": 8,
          "maximum": 4096
        },
        "export_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        }
      }
    }
  },
  "$comment": "Rust also enforces aggregate request bytes, safe relative paths and reserved environment, snapshot path/type/byte bounds, disk <= memory/2, exact image/snapshot/host grant binding and combined output+export budget. Filesystem capacity is allocated tmpfs pages, not aggregate logical file lengths. CPU rate denominator is one CPU; lifetime user+kernel CPU remains monitored with separate host and grant opt-in. Root is read-only, no host mounts are provided, and raw archive is never extracted on the host. Runtime cannot be selected as a silent fallback from native execution."
}
