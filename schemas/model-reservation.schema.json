{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "melissa:model-reservation:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "task_id",
    "profile_id",
    "provider_id",
    "model_id",
    "request_digest",
    "pricing_digest",
    "reserved_input_tokens",
    "reserved_output_tokens",
    "reserved_cost_micro_usd",
    "created_at_unix_ms"
  ],
  "properties": {
    "schema_version": {
      "const": "melissa.model-reservation/v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000]*\\S[^\\u0000]*$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000]*\\S[^\\u0000]*$"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000]*\\S[^\\u0000]*$"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000]*\\S[^\\u0000]*$"
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000]*\\S[^\\u0000]*$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "pricing_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^blake3:[0-9a-f]{64}$"
        }
      ]
    },
    "reserved_input_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "reserved_output_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "reserved_cost_micro_usd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "created_at_unix_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pricing_digest": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "reserved_cost_micro_usd": {
            "minimum": 1
          }
        }
      }
    }
  ]
}