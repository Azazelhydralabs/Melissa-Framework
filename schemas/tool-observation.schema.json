{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:melissa:schema:tool-observation:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "melissa.tool-observation/v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "success",
        "failed",
        "cancelled",
        "timed_out",
        "blocked",
        "outcome_unknown"
      ]
    },
    "effect_status": {
      "enum": [
        "not_started",
        "observed",
        "no_effect",
        "unknown",
        "reconciled"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "error_category": {
      "type": [
        "string",
        "null"
      ]
    },
    "resource_usage": {
      "type": "object"
    },
    "input_digest": {
      "type": "string",
      "minLength": 1
    },
    "output_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "invocation_id",
    "attempt_id",
    "tool_id",
    "status",
    "effect_status",
    "summary",
    "artifact_refs",
    "evidence_refs",
    "exit_code",
    "duration_ms",
    "truncated",
    "error_category",
    "resource_usage",
    "input_digest",
    "output_digest",
    "environment_ref"
  ],
  "additionalProperties": false
}
