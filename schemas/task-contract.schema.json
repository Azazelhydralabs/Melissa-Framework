{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:melissa:schema:task-contract:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "melissa.task-contract/v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "module": {
      "enum": [
        "core",
        "code",
        "cyber",
        "science",
        "game",
        "repack",
        "fit",
        "grid"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "workspace_ref": {
      "type": "string",
      "minLength": 1
    },
    "input_snapshot_digest": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_contract_digest": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "selected_profile_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowed_resource_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowed_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "authorization_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_wall_time_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_micro_usd": {
          "type": "integer",
          "minimum": 0
        },
        "max_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_parallel_jobs": {
          "type": "integer",
          "minimum": 1
        },
        "max_disk_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_wall_time_ms",
        "max_cost_micro_usd",
        "max_input_tokens",
        "max_output_tokens",
        "max_parallel_jobs",
        "max_disk_bytes",
        "max_output_bytes"
      ],
      "additionalProperties": false
    },
    "authority_source": {
      "const": "user_task_and_rust_policy"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "module",
    "goal",
    "workspace_ref",
    "input_snapshot_digest",
    "acceptance_contract_digest",
    "acceptance_criteria",
    "selected_profile_ids",
    "allowed_resource_ids",
    "allowed_effects",
    "authorization_refs",
    "limits",
    "authority_source"
  ],
  "additionalProperties": false
}
