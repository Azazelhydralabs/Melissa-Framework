{
  "schema_version": "melissa.worker-type/v1",
  "id": "windows-install-vm",
  "name_tr": "Temiz Windows Kurulum VM Worker",
  "modules": [
    "fit"
  ],
  "declared_platforms": [
    "windows-vm"
  ],
  "purpose_tr": "Temiz Windows snapshot'larında install/update/uninstall/rollback ve uyumluluk kabulünü çalıştırır.",
  "tool_families": [
    "distribution"
  ],
  "requirements_tr": [
    "temiz VM snapshot ve OS matrisi",
    "imzalı manifest ve güven kökü",
    "kullanıcı verisi fixture'ları"
  ],
  "isolation_contract_tr": "Host dizin/clipboard/network paylaşımı açık izinle; installer ayrıcalığı VM sınırında.",
  "job_contract": {
    "required": [
      "task_id",
      "invocation_id",
      "attempt_id",
      "lease_generation",
      "permit_ref",
      "arguments_digest",
      "input_artifact_refs",
      "limits",
      "cancellation_ref"
    ],
    "returns": [
      "status",
      "effect_status",
      "exit_code",
      "artifact_refs",
      "evidence_refs",
      "resource_usage",
      "error_category",
      "cleanup_status",
      "duration_ms"
    ]
  },
  "resource_policy": {
    "authority": "task_and_broker",
    "limits": [
      "wall_time",
      "cpu",
      "ram",
      "disk",
      "output_bytes",
      "network_scope",
      "gpu_vram_when_applicable"
    ],
    "unbounded_jobs": false
  },
  "lifecycle": [
    "registered",
    "ready",
    "leased",
    "running",
    "cancelling",
    "reconciling",
    "finished",
    "quarantined"
  ],
  "acceptance_checks_tr": [
    "install/update/uninstall tekrarları",
    "kesinti/disk dolması rollback",
    "eski sürüme zorla dönüş reddi",
    "kullanıcı verileri korunur"
  ],
  "implementation": {
    "definition": "complete",
    "executor": "not_implemented",
    "local_acceptance": "not_run",
    "live_acceptance": "not_run"
  }
}
