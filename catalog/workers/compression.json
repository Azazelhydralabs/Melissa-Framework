{
  "schema_version": "melissa.worker-type/v1",
  "id": "compression",
  "name_tr": "Sıkıştırma Worker",
  "modules": [
    "repack",
    "fit"
  ],
  "declared_platforms": [
    "windows",
    "linux"
  ],
  "purpose_tr": "Codec benchmark, CDC/chunk/dedup, delta, sıkıştırma ve geri açma çalıştırır.",
  "tool_families": [
    "repack",
    "distribution"
  ],
  "requirements_tr": [
    "sabit codec/build sürümü",
    "girdi corpus/manifest hash'i",
    "RAM/disk/time kotaları"
  ],
  "isolation_contract_tr": "Arşiv ve path traversal korumalı; girdi salt okunur, çıktı scratch alanında atomik yayımlanır.",
  "job_contract": {
    "required": [
      "task_id",
      "invocation_id",
      "attempt_id",
      "lease_generation",
      "permit_ref",
      "arguments_digest",
      "input_artifact_refs",
      "limits",
      "cancellation_ref"
    ],
    "returns": [
      "status",
      "effect_status",
      "exit_code",
      "artifact_refs",
      "evidence_refs",
      "resource_usage",
      "error_category",
      "cleanup_status",
      "duration_ms"
    ]
  },
  "resource_policy": {
    "authority": "task_and_broker",
    "limits": [
      "wall_time",
      "cpu",
      "ram",
      "disk",
      "output_bytes",
      "network_scope",
      "gpu_vram_when_applicable"
    ],
    "unbounded_jobs": false
  },
  "lifecycle": [
    "registered",
    "ready",
    "leased",
    "running",
    "cancelling",
    "reconciling",
    "finished",
    "quarantined"
  ],
  "acceptance_checks_tr": [
    "byte/metadata geri dönüşü",
    "bozuk chunk/yanlış delta tabanı reddi",
    "RAM sınırı uygulanır",
    "kesintide kullanıcı girdisi korunur"
  ],
  "implementation": {
    "definition": "complete",
    "executor": "not_implemented",
    "local_acceptance": "not_run",
    "live_acceptance": "not_run"
  }
}
