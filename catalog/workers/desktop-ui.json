{
  "schema_version": "melissa.worker-type/v1",
  "id": "desktop-ui",
  "name_tr": "Windows Masaüstü Worker",
  "modules": [
    "core",
    "code",
    "game",
    "fit"
  ],
  "declared_platforms": [
    "windows"
  ],
  "purpose_tr": "Yetkilendirilmiş Windows pencerelerinde UI Automation, gözlem ve kapsamlı input uygular.",
  "tool_families": [
    "desktop"
  ],
  "requirements_tr": [
    "kullanıcı/session/window kimliği",
    "fresh snapshot ve element referansı",
    "uygun integrity level"
  ],
  "isolation_contract_tr": "CLI worker'dan ayrı etkileşimli oturum; foreground ve input sahibi denetlenir, yükseltilmiş pencere için genel admin çözümü kullanılmaz.",
  "job_contract": {
    "required": [
      "task_id",
      "invocation_id",
      "attempt_id",
      "lease_generation",
      "permit_ref",
      "arguments_digest",
      "input_artifact_refs",
      "limits",
      "cancellation_ref"
    ],
    "returns": [
      "status",
      "effect_status",
      "exit_code",
      "artifact_refs",
      "evidence_refs",
      "resource_usage",
      "error_category",
      "cleanup_status",
      "duration_ms"
    ]
  },
  "resource_policy": {
    "authority": "task_and_broker",
    "limits": [
      "wall_time",
      "cpu",
      "ram",
      "disk",
      "output_bytes",
      "network_scope",
      "gpu_vram_when_applicable"
    ],
    "unbounded_jobs": false
  },
  "lifecycle": [
    "registered",
    "ready",
    "leased",
    "running",
    "cancelling",
    "reconciling",
    "finished",
    "quarantined"
  ],
  "acceptance_checks_tr": [
    "yanlış pencereye input yok",
    "stale snapshot reddedilir",
    "kilitli/başka session açıkça raporlanır",
    "iptalde basılı tuş/input temizlenir"
  ],
  "implementation": {
    "definition": "complete",
    "executor": "not_implemented",
    "local_acceptance": "not_run",
    "live_acceptance": "not_run"
  }
}
