{
  "schema_version": "melissa.worker-type/v1",
  "id": "science-gpu",
  "name_tr": "Science GPU Worker",
  "modules": [
    "science"
  ],
  "declared_platforms": [
    "windows",
    "linux"
  ],
  "purpose_tr": "GPU gerektiren sayısal/ML hesapları ve parametre taramalarını çalıştırır.",
  "tool_families": [
    "science"
  ],
  "requirements_tr": [
    "GPU/driver/runtime uyumluluk matrisi",
    "VRAM rezervasyonu",
    "dataset/model erişim izni"
  ],
  "isolation_contract_tr": "GPU işi ayrı süreçte; VRAM/OOM ve host erişimi sınırlanır. Native Windows/WSL/Linux desteği ayrı kanıtlanır.",
  "job_contract": {
    "required": [
      "task_id",
      "invocation_id",
      "attempt_id",
      "lease_generation",
      "permit_ref",
      "arguments_digest",
      "input_artifact_refs",
      "limits",
      "cancellation_ref"
    ],
    "returns": [
      "status",
      "effect_status",
      "exit_code",
      "artifact_refs",
      "evidence_refs",
      "resource_usage",
      "error_category",
      "cleanup_status",
      "duration_ms"
    ]
  },
  "resource_policy": {
    "authority": "task_and_broker",
    "limits": [
      "wall_time",
      "cpu",
      "ram",
      "disk",
      "output_bytes",
      "network_scope",
      "gpu_vram_when_applicable"
    ],
    "unbounded_jobs": false
  },
  "lifecycle": [
    "registered",
    "ready",
    "leased",
    "running",
    "cancelling",
    "reconciling",
    "finished",
    "quarantined"
  ],
  "acceptance_checks_tr": [
    "VRAM yetersizliği açık hata",
    "CPU/ref tolerans karşılaştırması",
    "iptalde GPU işi bırakılmaz",
    "deterministik olmayan sonuç varyansı raporlanır"
  ],
  "implementation": {
    "definition": "complete",
    "executor": "not_implemented",
    "local_acceptance": "not_run",
    "live_acceptance": "not_run"
  }
}
