{
  "schema_version": "melissa.worker-type/v1",
  "id": "generic",
  "name_tr": "Genel Kod Worker",
  "modules": [
    "core",
    "code"
  ],
  "declared_platforms": [
    "windows",
    "linux"
  ],
  "purpose_tr": "Repository araçlarını, build/test/debug süreçlerini ve deterministik yardımcıları çalıştırır.",
  "tool_families": [
    "code",
    "process",
    "git"
  ],
  "requirements_tr": [
    "toolchain ve executable sürümü",
    "kapsamlı çalışma alanı handle'ı",
    "ayrı scratch/build dizini"
  ],
  "isolation_contract_tr": "Proje build.rs/test kodu yürütür; dosya/ağ izolasyonu ve süreç ağacı sınırı gerçek executor'da uygulanır.",
  "job_contract": {
    "required": [
      "task_id",
      "invocation_id",
      "attempt_id",
      "lease_generation",
      "permit_ref",
      "arguments_digest",
      "input_artifact_refs",
      "limits",
      "cancellation_ref"
    ],
    "returns": [
      "status",
      "effect_status",
      "exit_code",
      "artifact_refs",
      "evidence_refs",
      "resource_usage",
      "error_category",
      "cleanup_status",
      "duration_ms"
    ]
  },
  "resource_policy": {
    "authority": "task_and_broker",
    "limits": [
      "wall_time",
      "cpu",
      "ram",
      "disk",
      "output_bytes",
      "network_scope",
      "gpu_vram_when_applicable"
    ],
    "unbounded_jobs": false
  },
  "lifecycle": [
    "registered",
    "ready",
    "leased",
    "running",
    "cancelling",
    "reconciling",
    "finished",
    "quarantined"
  ],
  "acceptance_checks_tr": [
    "workspace dışı okuma/yazma engellenir",
    "izinsiz ağ engellenir",
    "iptal alt süreç bırakmaz",
    "build/test ham çıktısı ve kaynak hash'i kaydedilir"
  ],
  "implementation": {
    "definition": "complete",
    "executor": "not_implemented",
    "local_acceptance": "not_run",
    "live_acceptance": "not_run"
  }
}
