{
  "schema_version": "melissa.worker-type/v1",
  "id": "browser",
  "name_tr": "Tarayıcı Worker",
  "modules": [
    "core",
    "code",
    "cyber"
  ],
  "declared_platforms": [
    "windows",
    "linux"
  ],
  "purpose_tr": "Sayfa/DOM inceleme, kontrollü etkileşim, ekran görüntüsü ve web kabul testlerini çalıştırır.",
  "tool_families": [
    "browser",
    "web"
  ],
  "requirements_tr": [
    "sabit browser/driver sürümü",
    "izole test profili veya ayrı yetkili mevcut oturum",
    "host/domain kapsamı"
  ],
  "isolation_contract_tr": "İzole ve authenticated oturumlar farklı capability; redirect/download/upload ve her gerçek hedef yeniden denetlenir.",
  "job_contract": {
    "required": [
      "task_id",
      "invocation_id",
      "attempt_id",
      "lease_generation",
      "permit_ref",
      "arguments_digest",
      "input_artifact_refs",
      "limits",
      "cancellation_ref"
    ],
    "returns": [
      "status",
      "effect_status",
      "exit_code",
      "artifact_refs",
      "evidence_refs",
      "resource_usage",
      "error_category",
      "cleanup_status",
      "duration_ms"
    ]
  },
  "resource_policy": {
    "authority": "task_and_broker",
    "limits": [
      "wall_time",
      "cpu",
      "ram",
      "disk",
      "output_bytes",
      "network_scope",
      "gpu_vram_when_applicable"
    ],
    "unbounded_jobs": false
  },
  "lifecycle": [
    "registered",
    "ready",
    "leased",
    "running",
    "cancelling",
    "reconciling",
    "finished",
    "quarantined"
  ],
  "acceptance_checks_tr": [
    "kapsam dışı redirect durur",
    "bir sekmeye input diğerini değiştirmez",
    "oturumlar arası cookie aktarılmaz",
    "stale hedef referansı reddedilir"
  ],
  "implementation": {
    "definition": "complete",
    "executor": "not_implemented",
    "local_acceptance": "not_run",
    "live_acceptance": "not_run"
  }
}
