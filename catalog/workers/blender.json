{
  "schema_version": "melissa.worker-type/v1",
  "id": "blender",
  "name_tr": "Blender Worker",
  "modules": [
    "game"
  ],
  "declared_platforms": [
    "windows",
    "linux"
  ],
  "purpose_tr": "Blender veri API'si ve izinli script'lerle mesh, sahne, rig, animasyon ve render üretir.",
  "tool_families": [
    "game"
  ],
  "requirements_tr": [
    "Blender sürümü/eklenti lisansları",
    "asset girdi hash'leri",
    "headless ve UI-context ayrımı"
  ],
  "isolation_contract_tr": "Script/asset izole süreçte; UI-context isteyen operator destek durumu açık, otomatik script çalıştırma kontrollü.",
  "job_contract": {
    "required": [
      "task_id",
      "invocation_id",
      "attempt_id",
      "lease_generation",
      "permit_ref",
      "arguments_digest",
      "input_artifact_refs",
      "limits",
      "cancellation_ref"
    ],
    "returns": [
      "status",
      "effect_status",
      "exit_code",
      "artifact_refs",
      "evidence_refs",
      "resource_usage",
      "error_category",
      "cleanup_status",
      "duration_ms"
    ]
  },
  "resource_policy": {
    "authority": "task_and_broker",
    "limits": [
      "wall_time",
      "cpu",
      "ram",
      "disk",
      "output_bytes",
      "network_scope",
      "gpu_vram_when_applicable"
    ],
    "unbounded_jobs": false
  },
  "lifecycle": [
    "registered",
    "ready",
    "leased",
    "running",
    "cancelling",
    "reconciling",
    "finished",
    "quarantined"
  ],
  "acceptance_checks_tr": [
    "invalid mesh/rig tespit edilir",
    "headless context hatası başarı olmaz",
    "dosya açılıp doğrulanır",
    "render/asset kanıtı kaynakla bağlanır"
  ],
  "implementation": {
    "definition": "complete",
    "executor": "not_implemented",
    "local_acceptance": "not_run",
    "live_acceptance": "not_run"
  }
}
