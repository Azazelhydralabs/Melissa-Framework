{
  "schema_version": "melissa.worker-type/v1",
  "id": "unreal-test",
  "name_tr": "Unreal Oynanış Test Worker",
  "modules": [
    "game"
  ],
  "declared_platforms": [
    "windows",
    "linux"
  ],
  "purpose_tr": "Gauntlet ve Melissa runtime bridge ile oyunu başlatır, input/telemetry/assertion toplar.",
  "tool_families": [
    "game"
  ],
  "requirements_tr": [
    "test edilmiş paket digest'i",
    "uyumlu runtime bridge",
    "senaryo ve donanım/render profili"
  ],
  "isolation_contract_tr": "Oyun içi kontrol editor Python'dan ayrıdır; test binary'si ve input session'ı kapsamlıdır.",
  "job_contract": {
    "required": [
      "task_id",
      "invocation_id",
      "attempt_id",
      "lease_generation",
      "permit_ref",
      "arguments_digest",
      "input_artifact_refs",
      "limits",
      "cancellation_ref"
    ],
    "returns": [
      "status",
      "effect_status",
      "exit_code",
      "artifact_refs",
      "evidence_refs",
      "resource_usage",
      "error_category",
      "cleanup_status",
      "duration_ms"
    ]
  },
  "resource_policy": {
    "authority": "task_and_broker",
    "limits": [
      "wall_time",
      "cpu",
      "ram",
      "disk",
      "output_bytes",
      "network_scope",
      "gpu_vram_when_applicable"
    ],
    "unbounded_jobs": false
  },
  "lifecycle": [
    "registered",
    "ready",
    "leased",
    "running",
    "cancelling",
    "reconciling",
    "finished",
    "quarantined"
  ],
  "acceptance_checks_tr": [
    "başarı/assertion/crash/timeout ayrılır",
    "telemetry gerçek run ile bağlı",
    "shader ısınması/performance koşulu kayıtlı",
    "çıkışta oyun süreci kapanır"
  ],
  "implementation": {
    "definition": "complete",
    "executor": "not_implemented",
    "local_acceptance": "not_run",
    "live_acceptance": "not_run"
  }
}
