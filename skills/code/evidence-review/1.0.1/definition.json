{
  "schema_version": "melissa.skill-definition/v1",
  "id": "melissa.code.skill.evidence-review",
  "module": "code",
  "name_tr": "Kanıta dayalı review ve kod güvenliği",
  "description_tr": "Eyleme dönük gerçek kusuru doğru kaynak ve karşı örnekle göster; tarayıcı etiketini kesin bulgu yapma.",
  "use_when": [
    "code_review",
    "security_review"
  ],
  "manifest": {
    "entrypoint": "SKILL.md",
    "category": "coding",
    "trust_level": "first_party",
    "routing": {
      "intents": [
        "code_review",
        "security_review"
      ],
      "priority": 80
    },
    "required_tools": [
      "fs.read",
      "code.references"
    ],
    "required_capabilities": [
      "workspace.read"
    ],
    "prerequisites": [
      "host-reviewed captured package and exact task policy",
      "A current source-bound native test receipt must be supplied; readonly reviewers do not execute or modify source. Missing evidence stays open."
    ],
    "runtime": {
      "timeout_seconds": 1800,
      "max_iterations": 64,
      "max_parallel_tools": 2,
      "max_cost_micro_usd": 1250000
    },
    "input_schema_ref": "schemas/input.json",
    "output_schema_ref": "schemas/output.json",
    "verification": [
      {
        "check": "source_bound_real_tool_evidence",
        "required": true
      },
      {
        "check": "negative_case_and_scope_preservation",
        "required": true
      }
    ],
    "evaluation": {
      "dataset_ref": "evals/cases.jsonl",
      "assertions_ref": "evals/assertions.json",
      "min_success_rate": 1.0
    }
  },
